#!/usr/bin/env python3
"""校验某 phase 的必需产物文件是否齐全。core 文件恒查，plugin 文件按 task-config
的 `plugins.<name>.enabled` 条件查。全部齐全 → PASS / exit 0；缺文件 → FAIL / exit 1。"""
import json
import os
import re
import sys


def usage():
    print("Usage: hat-task-artifact-check <task-folder-path> <phase-number> "
          "[--config <task-config.json>]", file=sys.stderr)
    sys.exit(1)


def main(argv):
    if len(argv) < 3:
        usage()

    task_dir = argv[1]
    phase = argv[2]
    config_file = os.path.join(task_dir, "task-config.json")

    rest = argv[3:]
    i = 0
    while i < len(rest):
        if rest[i] == "--config" and i + 1 < len(rest):
            config_file = rest[i + 1]
            i += 2
        else:
            usage()

    if not os.path.isdir(task_dir):
        print(f"Error: task folder not found: {task_dir}", file=sys.stderr)
        sys.exit(1)

    if not re.fullmatch(r"[1-6]", phase):
        print("Error: phase-number must be between 1 and 6", file=sys.stderr)
        sys.exit(1)

    config = {}
    if os.path.isfile(config_file):
        try:
            with open(config_file) as f:
                config = json.load(f)
        except (ValueError, OSError):
            config = {}

    def plugin_enabled(name):
        # 判据与 hat-plugin-hook 引擎保持一致：True 或 "auto" 视为启用
        entry = (config.get("plugins") or {}).get(name)
        return isinstance(entry, dict) and (entry.get("enabled") is True or entry.get("enabled") == "auto")

    missing = 0

    def check_file(filename):
        nonlocal missing
        if os.path.isfile(os.path.join(task_dir, filename)):
            print(f"✅ {filename}")
        else:
            print(f"❌ {filename} (missing)")
            missing += 1

    if phase == "1":
        check_file("prompt.md")
        check_file("phases.md")
        if plugin_enabled("linear"):
            check_file("linear.json")
    elif phase == "2":
        check_file("design.md")
    elif phase == "3":
        check_file("plan.md")
    elif phase == "4":
        pass
    elif phase == "5":
        check_file("acceptance-checklist.md")
    elif phase == "6":
        check_file("final.md")
        check_file("conversation.md")
        check_file("consumption-report.md")

    if missing == 0:
        print("PASS")
        sys.exit(0)
    print(f"FAIL: {missing} file(s) missing")
    sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
