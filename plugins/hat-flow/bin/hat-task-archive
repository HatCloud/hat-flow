#!/usr/bin/env python3
"""
hat-task-archive — 将任务文件夹从 open/ 移动到目标目录，并创建 git commit。

用法:
    hat-task-archive <task_name> <done|canceled|deferred> [选项]

选项:
    --extra-files f1 f2 ...    额外需要 git add 的文件（如 CLAUDE.md）
    --message "msg"            自定义 commit 消息（不提供则自动生成）

示例:
    hat-task-archive "2026-03-02-avatar-system" canceled
    hat-task-archive "2026-03-01-audio" done --message "docs: complete audio task"

输出 (JSON):
    {
      "archived": true,
      "from": ".tasks/open/...",
      "to": ".tasks/canceled/...",
      "committed": true,
      "commitHash": "abc1234"
    }

Exit codes:
    0 = 成功
    1 = 出错（源目录不存在、git 操作失败等）

注意: 此脚本只 git add 归档相关的文件，绝不会 git add -A，
      避免把不相关的文件（如 .env、调试代码）意外提交。
"""

import json
import os
import shutil
import subprocess
import sys


def git(*args):
    """
    运行一条 git 命令并返回结果。

    capture_output=True 表示捕获 stdout 和 stderr（不直接打印到终端）。
    text=True 表示输出为字符串而非 bytes。
    timeout=120 表示最多等待 120 秒：commit 会触发 pre-commit hook
    （含 site/ 改动时跑 tsc，约 10-20s），10s 会必然超时，故放宽。
    快操作（mv/add）仍立即返回，不受影响。
    """
    result = subprocess.run(
        ["git"] + list(args), capture_output=True, text=True, timeout=120,
    )
    return result


def die(msg):
    """输出错误信息到 stderr 并以 exit code 1 退出。"""
    print(json.dumps({"error": msg}), file=sys.stderr)
    sys.exit(1)


def main():
    # ---- 1. 解析命令行参数 ----

    if len(sys.argv) < 3:
        die("Usage: hat-task-archive <task_name> <done|canceled|deferred> [--extra-files f1 f2 ...] [--message \"msg\"]")

    task_name = sys.argv[1]      # 任务文件夹名，如 "2026-03-02-avatar-system"
    destination = sys.argv[2]    # 目标: done / canceled / deferred

    # 校验目标是否合法
    if destination not in ("done", "canceled", "deferred"):
        die(f"Invalid destination: {destination}. Must be 'done', 'canceled', or 'deferred'.")

    # 解析可选参数: --extra-files 和 --message
    extra_files = []
    message = None
    i = 3
    while i < len(sys.argv):
        if sys.argv[i] == "--extra-files":
            # --extra-files 后面跟若干文件路径，直到遇到下一个 -- 开头的参数为止
            i += 1
            while i < len(sys.argv) and not sys.argv[i].startswith("--"):
                extra_files.append(sys.argv[i])
                i += 1
        elif sys.argv[i] == "--message":
            if i + 1 < len(sys.argv):
                message = sys.argv[i + 1]
                i += 2
            else:
                die("Missing value for --message")
        else:
            i += 1

    # ---- 2. 构建路径并校验 ----

    if os.path.isabs(task_name) or os.sep in task_name:
        src = os.path.normpath(task_name)
        folder_name = os.path.basename(src)
        parent = os.path.dirname(src)
        grandparent = os.path.dirname(parent)
        dest_dir = os.path.join(grandparent, destination)
        dest = os.path.join(dest_dir, folder_name)
    else:
        src = os.path.join(".tasks", "open", task_name)
        dest_dir = os.path.join(".tasks", destination)
        dest = os.path.join(dest_dir, task_name)

    if not os.path.isdir(src):
        die(f"Source not found: {src}")
    if os.path.exists(dest):
        die(f"Destination already exists: {dest}")

    # ---- 3. 自动生成 commit 消息 ----

    if not message:
        # 根据目标自动选择动词: done→complete, canceled→cancel, deferred→defer
        verbs = {"done": "complete", "canceled": "cancel", "deferred": "defer"}
        verb = verbs[destination]
        message = f"docs: {verb} and archive task [{task_name}]"

    # ---- 4. 执行归档: 移动文件夹 ----

    os.makedirs(dest_dir, exist_ok=True)   # 确保目标父目录存在
    shutil.move(src, dest)                 # 移动整个任务文件夹

    # ---- 5. Git 操作: 暂存 + 提交 ----

    # 暂存新位置的文件夹
    r = git("add", dest)
    if r.returncode != 0:
        die(f"git add failed: {r.stderr.strip()}")

    # 暂存旧路径的删除（git 会自动检测到这是一次 rename/move）
    git("add", src)

    # 暂存额外指定的文件（仅当文件存在时）
    # 使用 -f 以处理 .gitignore 中已追踪的文件
    for f in extra_files:
        if os.path.exists(f):
            r = git("add", "-f", f)
            if r.returncode != 0:
                # 报告但不中断（extra files 失败不应阻止归档）
                print(json.dumps({"warning": f"git add -f {f} failed: {r.stderr.strip()}"}), file=sys.stderr)

    # 创建 commit
    r = git("commit", "-m", message)
    committed = r.returncode == 0

    # 获取刚创建的 commit 的短 hash（如 "abc1234"）
    commit_hash = None
    if committed:
        r2 = git("log", "-1", "--format=%h")
        commit_hash = r2.stdout.strip() if r2.returncode == 0 else None

    # ---- 6. 输出结果 ----

    result = {
        "archived": True,
        "from": src,
        "to": dest,
        "committed": committed,
        "commitHash": commit_hash,
    }
    if not committed:
        result["commitError"] = r.stderr.strip()

    print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    main()
