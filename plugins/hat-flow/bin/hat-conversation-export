#!/usr/bin/env bash
set -euo pipefail

PROJECTS_DIR="$HOME/.claude/projects"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
  cat <<'USAGE'
Usage: hat-conversation-export <output-path> [session-id]

Export a Claude Code conversation to Markdown + consumption report.

Arguments:
  output-path   Path for the output file (required)
  session-id    Session UUID (optional, defaults to most recent JSONL)

The script searches all project directories under ~/.claude/projects/
for JSONL conversation files.
USAGE
  exit 1
}

[ $# -lt 1 ] && usage
OUTPUT_PATH="$1"
SESSION_ID="${2:-}"

if [ ! -d "$PROJECTS_DIR" ]; then
  echo "Error: Projects directory not found: $PROJECTS_DIR" >&2
  exit 1
fi

# 解析 session id 列表：显式参数 > 同目录 session.json > fallback 最新 jsonl
OUT_DIR="$(dirname "$OUTPUT_PATH")"
SESSION_IDS=()
if [ -n "$SESSION_ID" ]; then
  SESSION_IDS+=("$SESSION_ID")
elif [ -f "$OUT_DIR/session.json" ]; then
  while IFS= read -r sid; do
    [ -n "$sid" ] && SESSION_IDS+=("$sid")
  done < <(python3 -c 'import json,sys
try:
    d=json.load(open(sys.argv[1]))
    print("\n".join(d.get("sessions",[])))
except Exception:
    pass' "$OUT_DIR/session.json" 2>/dev/null)
fi

JSONL_FILES=()
if [ "${#SESSION_IDS[@]}" -gt 0 ]; then
  for sid in "${SESSION_IDS[@]}"; do
    # 同一 session-id 可能在多个 project 目录各有一份（worktree 任务尤甚：真实
    # transcript 在主 project 目录、worktree 目录常只有 1 行 stub）。按文件大小
    # 降序取最大那份，避免 head -1 抓到空 stub。
    jf=$(find "$PROJECTS_DIR" -name "${sid}.jsonl" -type f -print0 2>/dev/null \
      | xargs -0 ls -S 2>/dev/null | head -1)
    if [ -z "$jf" ]; then
      echo "Error: No JSONL file found for session: $sid" >&2
      exit 1
    fi
    JSONL_FILES+=("$jf")
  done
else
  # fallback：最新 jsonl——未经 session.json 确认，数据可能串任务
  jf=$(find "$PROJECTS_DIR" -name "*.jsonl" -type f -print0 2>/dev/null \
    | xargs -0 ls -t 2>/dev/null | head -1 || true)
  if [ -z "$jf" ]; then
    echo "Error: No JSONL conversation files found in $PROJECTS_DIR" >&2
    exit 1
  fi
  echo "⚠️  未经 session.json 确认：回退到最新 jsonl ($jf)。分析数据可能串任务——建议为任务记录 session.json。" >&2
  JSONL_FILES+=("$jf")
fi

exec python3 "${SCRIPT_DIR}/hat-conversation-export.py" "${JSONL_FILES[@]}" "$OUTPUT_PATH"
