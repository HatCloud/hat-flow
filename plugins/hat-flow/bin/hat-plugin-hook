#!/usr/bin/env python3
"""Task plugin hook 引擎：解析 task-config 启用的插件，收集某 hook-point 注册的
handler，按 priority 排序，从各插件 .md 抽取 section 正文拼接输出。
所有 handler 均 inline——输出注释头 + 指令正文，由编排器在主线程逐段同步执行。
无 handler 时 exit 0、stdout 为空。

PLUGINS_DIR 默认相对脚本自身定位（bin/ 与 skills/ 同父平级，dirname/.. 解析到仓库根），
可经 PLUGINS_DIR 环境变量覆盖（测试用）。
"""
import json
import os
import sys

USAGE = """Usage: hat-plugin-hook <task-folder> <hook-point>

Resolves enabled plugins for a task, collects handlers registered
at <hook-point>, sorts by priority, and outputs
the concatenated instruction text from each plugin's .md file.

Every handler is inline: a comment header plus its instruction body,
executed in order by the orchestrator on the main thread.

Exit 0 with empty stdout when no handlers are registered."""


def usage(code=0):
    print(USAGE)
    sys.exit(code)


def err(msg):
    print(msg, file=sys.stderr)


def plugins_dir():
    override = os.environ.get("PLUGINS_DIR")
    if override:
        return override
    skill_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    return os.path.join(skill_root, "skills", "task", "plugins")


def coalesce(value, default):
    """null 合并：仅当 value 为 null/false 时取默认（沿用旧引擎的 `// default` 语义）。"""
    return default if value is None or value is False else value


def extract_section(text, pat):
    """复刻旧版 awk：从整行 == pat 的标题行之后，抽到下一个 `## ` 标题或 EOF。
    fence-aware（``` 切换围栏，围栏内的 `## ` 不算标题、照常输出）。标题行本身不输出。"""
    if text.endswith("\n"):
        text = text[:-1]
    in_fence = False
    printing = False
    out = []
    for line in text.split("\n"):
        if line.startswith("```"):
            in_fence = not in_fence
        if not in_fence and line == pat:
            printing = True
            continue
        if printing and not in_fence and line.startswith("## "):
            printing = False
        if printing:
            out.append(line)
    # 旧版 section_content=$(awk ...) 经命令替换去掉所有尾部换行
    return "\n".join(out).rstrip("\n")


def load_json(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def parse_frontmatter(text):
    """从 .md 顶部 `---` 围栏解析 manifest。frontmatter 体为 JSON（JSON 是 YAML 1.2
    子集，用 stdlib json 解析、零外部依赖）。无 frontmatter / 解析失败 → None。"""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            try:
                return json.loads("\n".join(lines[1:i]))
            except ValueError:
                return None
    return None


def main(argv):
    if len(argv) < 3:
        usage(1)

    task_folder = argv[1]
    hook_point = argv[2]

    if not os.path.isdir(task_folder):
        err(f"Error: task folder not found: {task_folder}")
        sys.exit(1)

    config_file = os.path.join(task_folder, "task-config.json")
    if not os.path.isfile(config_file):
        err(f"[WARN] task-config.json not found in {task_folder}, skipping")
        sys.exit(0)

    try:
        config = load_json(config_file)
    except (ValueError, OSError):
        err(f"Error: failed to parse {config_file}")
        sys.exit(1)

    plugins = config.get("plugins") or {}
    enabled = [
        name for name, v in plugins.items()
        if isinstance(v, dict) and (v.get("enabled") is True or v.get("enabled") == "auto")
    ]
    if not enabled:
        sys.exit(0)

    pdir = plugins_dir()

    # 收集 handler：保持 enabled 插件顺序 × 数组内顺序。manifest 住在 {name}.md 的
    # 顶部 frontmatter，.md 一次读取后既用于 manifest 解析也用于 section 抽取。
    md_texts = {}
    handlers = []
    for name in enabled:
        md_file = os.path.join(pdir, f"{name}.md")
        if not os.path.isfile(md_file):
            continue
        try:
            with open(md_file, encoding="utf-8") as f:
                md_text = f.read()
        except OSError:
            continue
        manifest = parse_frontmatter(md_text)
        if manifest is None:
            continue
        md_texts[name] = md_text
        hook_value = manifest.get("hooks", {}).get(hook_point)
        if hook_value is None or hook_value == "":
            continue
        entries = hook_value if isinstance(hook_value, list) else [hook_value]
        for entry in entries:
            handlers.append({**entry, "plugin": name})

    if not handlers:
        sys.exit(0)

    # priority 稳定升序排序（缺 priority 兜底 0，复刻旧 bash `// 0`；
    # 不能用 `or 0`——合法的 priority=0 会被 falsy 误伤）
    ordered = sorted(handlers, key=lambda h: h["priority"] if h.get("priority") is not None else 0)

    # 抽取 section 并输出
    first = True
    for h in ordered:
        plugin = h["plugin"]
        section_title = coalesce(h.get("section"), "")
        on_error = coalesce(h.get("on_error"), "graceful")

        if not section_title:
            continue

        section_content = extract_section(md_texts[plugin], section_title)

        if not section_content:
            if on_error == "blocking":
                err(f"[ERROR] {plugin}: section '{section_title}' not found in {plugin}.md")
                sys.exit(1)
            err(f"[!] {plugin}: section '{section_title}' not found, skipped")
            continue

        if first:
            first = False
        else:
            print()
            print("---")
            print()

        print(f"<!-- plugin:{plugin} hook:{hook_point} on_error:{on_error} -->")
        print(section_content)


if __name__ == "__main__":
    main(sys.argv)
