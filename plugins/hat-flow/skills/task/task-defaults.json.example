{
  "_schema_version": "2.0",
  "_comment": "任务流程全局默认配置。复制为 task-defaults.json 后生效，该文件不进 git。顶层 plugins 定义全局默认值，presets 定义档位覆盖，overrides 用于用户自定义覆盖。",
  "preset": "standard",

  "execution": {
    "mode": "inline",
    "_mode_values": "inline | subagent",
    "engine": "auto",
    "_engine_values": "auto | sonnet | opus",
    "_engine_note": "仅 mode=subagent 时生效"
  },

  "plugins": {
    "review": {
      "enabled": true,
      "design_rounds": "auto",
      "code_review": "medium",
      "reviewer": "claude",
      "max_rounds": 3
    },
    "linear": {
      "enabled": "auto",
      "update_description": true,
      "upload_docs": true,
      "sync_sub_issues": true
    },
    "git": {
      "enabled": "auto"
    },
    "tdd": {
      "enabled": false,
      "mode": "none"
    },
    "retrospective": {
      "enabled": true
    }
  },

  "observability": { "enabled": true },
  "_observability_note": "核心能力（非 plugin，HAT-444 下沉）：timing 由各 phase SKILL 在 phase 边界内联经 hat-timing-stamp 写入，受此顶层开关门控。与 todo_sync/phase_merge 同级；preset 可覆盖（hotfix 设 false）。",

  "todo_sync": true,
  "phase_merge": [],

  "overrides": {},

  "presets": {
    "full": {
      "execution": { "mode": "subagent", "engine": "auto" },
      "plugins": {
        "review": { "enabled": true, "code_review": "full" },
        "tdd": { "enabled": true, "mode": "full" },
        "retrospective": { "enabled": true }
      },
      "phase_merge": [],
      "todo_sync": true
    },
    "standard": {
      "execution": { "mode": "inline" },
      "plugins": {
        "review": { "enabled": true, "code_review": "medium" },
        "tdd": { "enabled": true, "mode": "lite" },
        "retrospective": { "enabled": true }
      },
      "phase_merge": [],
      "todo_sync": true
    },
    "lite": {
      "execution": { "mode": "inline" },
      "plugins": {
        "review": { "enabled": true, "code_review": "light", "design_rounds": 0 },
        "tdd": { "enabled": false, "mode": "none" },
        "retrospective": { "enabled": false }
      },
      "phase_merge": [],
      "todo_sync": true
    },
    "hotfix": {
      "execution": { "mode": "inline" },
      "plugins": {
        "review": { "enabled": false },
        "tdd": { "enabled": false, "mode": "none" },
        "retrospective": { "enabled": false }
      },
      "observability": { "enabled": false },
      "phase_merge": [],
      "todo_sync": false,
      "p5_auto_only": true
    }
  }
}
